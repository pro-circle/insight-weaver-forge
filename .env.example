# ----- Public client values only (everything here ships in the browser bundle) -----
# Copy this file to `.env` and fill in your real values BEFORE running `bun run build`.
# IMPORTANT: VITE_SUPABASE_URL must be your real Supabase project URL
#   (Project Settings → API → Project URL). A typo like "projrct-id.supabase.co"
#   will surface in the browser as a CORS error because the host doesn't resolve.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_NAME=Invoice Flow
VITE_FEEDBACK_GOOGLE_FORM_URL=
# YouTube video ID only (e.g. dQw4w9WgXcQ), NOT the full URL.
VITE_APP_TOUR_YOUTUBE_ID=

# All secrets (Groq, Gemini, EmailJS private key, cron secret) live in
# Supabase → Project Settings → Edge Functions → Secrets. NEVER add them here.
#   GROQ_API_KEY_1, GROQ_API_KEY_2, GEMINI_API_KEY,
#   EMAILJS_SERVICE_ID, EMAILJS_CONTACT_TEMPLATE_ID,
#   EMAILJS_PUBLIC_KEY, EMAILJS_PRIVATE_KEY, CRON_SECRET
